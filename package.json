{
  "name": "mori-gruvbox",
  "displayName": "Mozg (VS) Code - Theme Extension",
  "description": "Makes the Mozg (mori-code) chat follow your VS Code color theme - like the built-in Copilot chat. Works with any theme and switches with it.",
  "version": "3.1.0",
  "publisher": "eterna1-0blivion",
  "author": {
    "name": "eterna1-0blivion",
    "url": "https://github.com/eterna1-0blivion"
  },
  "contributors": [
    {
      "name": "Mozg AI",
      "url": "https://mozg.world",
      "comment": "The whole extension - code, tests, scripts, icon, documentation - was written by the Mozg AI assistant, working with eterna1-0blivion as the human reviewer."
    }
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mozg",
    "mori-code",
    "theme",
    "color theme",
    "follow theme",
    "copilot",
    "webview"
  ],
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/eterna1-0blivion/mori-gruvbox.git"
  },
  "bugs": {
    "url": "https://github.com/eterna1-0blivion/mori-gruvbox/issues"
  },
  "homepage": "https://github.com/eterna1-0blivion/mori-gruvbox#readme",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "moriGruvbox.applyMozgBridge",
        "title": "Apply Mozg Bridge (follow the VS Code theme)",
        "category": "Mozg Theme"
      },
      {
        "command": "moriGruvbox.revertMozgBridge",
        "title": "Revert Mozg Bridge",
        "category": "Mozg Theme"
      },
      {
        "command": "moriGruvbox.showMozgBridgeStatus",
        "title": "Show Mozg Bridge Status",
        "category": "Mozg Theme"
      }
    ],
    "configuration": {
      "title": "Mozg (VS) Code - Theme Extension",
      "properties": {
        "moriGruvbox.mozgBridge": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "off"
          ],
          "enumDescriptions": [
            "Ask before editing the Mozg stylesheet (default).",
            "Apply the bridge automatically, including after Mozg updates.",
            "Never touch the Mozg stylesheet."
          ],
          "default": "ask",
          "markdownDescription": "Whether this extension may edit the stylesheet of the Mozg extension (`mori-ai.mori-code`) so that Mozg uses the colors of the active VS Code theme. Mozg updates overwrite the edit; with `auto` it is re-applied on the next start."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/bridge.test.js test/browser.test.js test/extension.test.js",
    "icon": "node scripts/make-icon.mjs",
    "package": "vsce package --no-dependencies",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "puppeteer-core": "^25.18.1"
  },
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  }
}
