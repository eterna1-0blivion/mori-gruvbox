{
  "name": "mori-gruvbox",
  "displayName": "Mori Gruvbox",
  "description": "Gruvbox с нейтральным интерфейсом: подсветка кода Gruvbox, но панели, вкладки и чат — серые, без цветных акцентов. Плюс патч темы для расширения Mozg (mori-code).",
  "version": "1.0.0",
  "publisher": "eterna1-0blivion",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gruvbox",
    "dark",
    "theme",
    "neutral",
    "minimal",
    "mozg",
    "mori",
    "copilot"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eterna1-0blivion/mori-gruvbox.git"
  },
  "bugs": {
    "url": "https://github.com/eterna1-0blivion/mori-gruvbox/issues"
  },
  "homepage": "https://github.com/eterna1-0blivion/mori-gruvbox#readme",
  "contributes": {
    "themes": [
      {
        "label": "Mori Gruvbox Dark Hard",
        "uiTheme": "vs-dark",
        "path": "./themes/mori-gruvbox-dark-hard.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-theme.mjs",
    "check": "node scripts/build-theme.mjs --check",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/test-settings-block.ps1",
    "package": "npm run build && vsce package --no-dependencies",
    "install:theme": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-vscode-theme.ps1",
    "install:mozg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-mozg-theme.ps1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1"
  }
}
